---
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  job: CollectionEntry<'jobs'>;
}

const { job } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const role = lang === 'es' ? job.data.role_es : job.data.role_en;
const summary = lang === 'es' ? job.data.summary_es : job.data.summary_en;
const location = lang === 'es' ? job.data.location_es : job.data.location_en;
const highlights = lang === 'es' ? job.data.highlights_es : job.data.highlights_en;

function formatRange(start: string, end: string | undefined, presentLabel: string) {
  const fmt = (iso: string) => {
    const [y, m] = iso.split('-');
    const date = new Date(Number(y), Number(m) - 1, 1);
    return date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
      month: 'short',
      year: 'numeric',
    });
  };
  return `${fmt(start)} — ${end ? fmt(end) : presentLabel}`;
}
---

<li class="rounded-xl bg-surface-card p-8">
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div class="flex flex-wrap items-baseline gap-x-3">
        <h3 class="font-display text-2xl font-normal tracking-tight text-ink">{role}</h3>
        {
          job.data.url ? (
            <a
              href={job.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-medium text-primary underline-offset-4 hover:underline"
            >
              {job.data.company}
            </a>
          ) : (
            <span class="text-base font-medium text-body-strong">{job.data.company}</span>
          )
        }
      </div>
      <p class="caption-uppercase text-muted">
        {formatRange(job.data.start, job.data.end, t('experience.present'))}
      </p>
    </div>
    {location && <p class="text-sm text-muted">{location}</p>}
    <p class="text-base leading-relaxed text-body">{summary}</p>
    {
      highlights.length > 0 && (
        <ul class="mt-2 list-disc pl-5 text-base leading-relaxed text-body">
          {highlights.map((item) => (
            <li class="mt-1">{item}</li>
          ))}
        </ul>
      )
    }
    {
      job.data.stack.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-2">
          {job.data.stack.map((tech) => (
            <li class="inline-flex items-center rounded-full bg-canvas px-3 py-1 text-[13px] font-medium text-ink">
              {tech}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
