---
import { getLangFromUrl, useTranslations, localizedPath } from '@/i18n/utils';
import LangSwitch from '@/components/LangSwitch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: localizedPath('/#about', lang), label: t('nav.about') },
  { href: localizedPath('/#experience', lang), label: t('nav.experience') },
  { href: localizedPath('/#projects', lang), label: t('nav.projects') },
  { href: localizedPath('/uses', lang), label: t('nav.uses') },
];
---

<header class="sticky top-0 z-40 w-full bg-canvas/90 backdrop-blur supports-[backdrop-filter]:bg-canvas/75">
  <div class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-6 sm:px-8">
    <a
      href={localizedPath('/', lang)}
      class="flex items-center gap-2 text-ink transition-colors hover:text-primary"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="text-ink"
      >
        <!-- Anthropic-style radial spike mark -->
        <path d="M12 0 L13.5 10.5 L24 12 L13.5 13.5 L12 24 L10.5 13.5 L0 12 L10.5 10.5 Z" />
      </svg>
      <span class="text-[15px] font-medium tracking-tight">Manuel Campos</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-card hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <LangSwitch />
      <a
        href="mailto:contactomanuelgutierrez@gmail.com"
        class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-5 text-sm font-medium text-white transition-colors hover:bg-primary-active"
      >
        {t('hero.cta.contact')}
      </a>

      <details class="group/menu relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-ink transition-colors hover:bg-surface-card [&::-webkit-details-marker]:hidden"
          aria-label={t('nav.menu')}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="group-open/menu:hidden"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="hidden group-open/menu:block"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 flex w-52 flex-col gap-0.5 rounded-lg border border-hairline bg-canvas p-2 shadow-lg"
          aria-label="Mobile"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-card hover:text-ink"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
