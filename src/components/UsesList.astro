---
import { getCollection } from 'astro:content';
import { getLangFromUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const categories = (await getCollection('uses')).sort((a, b) => a.data.order - b.data.order);
---

<div class="flex flex-col gap-16">
  {
    categories.map((cat) => {
      const title = lang === 'es' ? cat.data.category_es : cat.data.category_en;
      return (
        <section data-reveal>
          <h2 class="display-md mb-6 text-ink">{title}</h2>
          <ul class="flex flex-col divide-y divide-hairline border-y border-hairline">
            {cat.data.items.map((item) => {
              const desc = lang === 'es' ? item.description_es : item.description_en;
              return (
                <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
                  <div class="flex items-center gap-3 sm:w-1/3 sm:shrink-0">
                    {item.image && (
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                        class="size-6 shrink-0 object-contain"
                      />
                    )}
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-base font-medium text-primary underline-offset-4 hover:underline"
                      >
                        {item.name}
                      </a>
                    ) : (
                      <span class="text-base font-medium text-ink">{item.name}</span>
                    )}
                  </div>
                  <p class="text-base leading-relaxed text-body">{desc}</p>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  }
</div>
